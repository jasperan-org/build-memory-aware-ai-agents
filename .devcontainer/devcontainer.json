{
  "name": "Designing and Building Memory for AI Agents",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // 4 cores / 16 GB / 32 GB disk: Oracle AI Database Free runs inside Docker-in-Docker next to
  // the Python environment and the ONNX model load; containerEnv below keeps it within the disk.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    // Docker 28, not latest: Docker 29 defaults to the containerd image store, which keeps the
    // compressed layers next to the unpacked ones. The Oracle image (~4 GB pulled, ~14 GB unpacked)
    // then filled the 32 GB Codespace disk and the container was never created.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false,
      "version": "28"
    },
    // Lets the Codespace owner use `gh codespace ssh` / `gh codespace logs` from a local terminal.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  // The Codespace disk is 32 GB. The official Oracle image (about 14 GB on disk) plus its database
  // left no room for VS Code's Python and Jupyter extensions (ENOSPC, so no notebook kernel), and
  // fresh Codespaces failed in postCreate. Codespaces therefore run gvenzl/oracle-free 23.26.4
  // faststart (1.7 GB download, database pre-built in the image), pinned by digest; local installs
  // keep the official image from docker-compose.yml. Package and model caches go to /tmp, a
  // separate 100+ GB disk that is cleared when the Codespace stops (nothing there is needed later).
  "containerEnv": {
    "ORACLE_IMAGE": "gvenzl/oracle-free@sha256:fbcb151fb81c13e6182ccaaa86443da3a623c0998a70c45ca043a75817cd18ef",
    "UV_CACHE_DIR": "/tmp/uv-cache",
    "UV_LINK_MODE": "copy",
    "HF_HOME": "/tmp/hf-cache"
  },

  // on-create: uv + Python deps + .env (prebuild-friendly, no Docker needed).
  // post-create: Oracle container, vector pool, ONNX model, readiness check.
  // post-start: restarts the Oracle container after a stopped Codespace resumes.
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "forwardPorts": [8888],
  "portsAttributes": {
    "1526": { "label": "Oracle AI Database", "onAutoForward": "silent" },
    "8888": { "label": "Jupyter Lab", "onAutoForward": "notify" }
  },

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "notebooks/01_oamp_memory_agent.ipynb"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
